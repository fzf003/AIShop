<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AIShop.Core\AIShop.Core.csproj" />
    <ProjectReference Include="..\AIShop.AgentTelemetry\AIShop.AgentTelemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAF 三包 1.18.0（T2 升级，D5）；DeepSeek.Agents.AI 1.0.4 保持不变（实测与 1.18 兼容） -->
    <PackageReference Include="DeepSeek.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <!-- P2 步骤 2：移除 Infrastructure 引用后 Serilog 不再传递，需显式声明（版本与 Infrastructure 对齐 4.3.0） -->
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <!-- T7 迁移 ModelRouter 到 Service：自建 HttpClient 管线（标准弹性策略）所需；
         版本与 AIShop.ServiceDefaults 对齐（10.7.0），传递引入 Polly / Microsoft.Extensions.Configuration / DI 抽象 -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试缝：使 internal static ModelRouter.BuildChatHttpPipeline 等对 Service.Tests 可见。
         （property 形式的 <InternalsVisibleTo> 不生成 friend 特性，必须用 item 形式 Include） -->
    <InternalsVisibleTo Include="AIShop.Service.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
