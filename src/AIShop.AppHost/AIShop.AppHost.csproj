<Project Sdk="Aspire.AppHost.Sdk/13.5.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>06a40fab-d330-4f05-81a9-77699d35b693</UserSecretsId>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <!-- ASPIRE010（Aspire 13.5.1 新增诊断）：纯 .NET AppHost 未启用 CLI bundle 特性，抑制以免阻塞 build（TreatWarningsAsErrors 会提升为 error） -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIShop.Api\AIShop.Api.csproj" />
    <ProjectReference Include="..\AIShop.McpServer\AIShop.McpServer.csproj" />
    <ProjectReference Include="..\AIShop.ServiceDefaults\AIShop.ServiceDefaults.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
