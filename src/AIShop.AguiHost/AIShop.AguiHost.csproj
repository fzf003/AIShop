<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 底座引用：AIShop.Service → Infrastructure → Core 传递获得全部底座类型（设计 §2，依赖方向 Core←Infra←Service←AguiHost） -->
    <ProjectReference Include="..\AIShop.Service\AIShop.Service.csproj" />
    <!-- Dashboard 可观测性（T10）：接入 ServiceDefaults → OTLP trace/metric/log + /health 健康端点（评审补强：
         未引 ServiceDefaults 时 Aspire Dashboard 看不到 agui 的 trace/log/健康状态；对齐老宿主 AIShop.Api） -->
    <ProjectReference Include="..\AIShop.ServiceDefaults\AIShop.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AG-UI 官方宿主 preview 包 + DevUI 开发面板 + OpenAI wire（T7）：版本已在 Directory.Packages.props 锁定
         （AGUI/Hosting.AspNetCore/DevUI = 1.20.0-preview.260831.1，Hosting.OpenAI = 1.20.0-alpha.260831.1），此处仅补引用。
         AddAGUIServer/MapAGUIServer/AsAIAgent 等 AG-UI 装配 API 与 AddDevUI/MapDevUI/AddOpenAI*/MapOpenAI*
         以本地镜像 preview 源码为准（设计 §4.1/§4.6；Hosting.OpenAI 为 alpha 非 preview） -->
    <!-- AGUI.Server / AGUI.Abstractions 显式提升到 0.0.6：AGUI.AspNetCore preview 传递依赖带来的是 0.0.5，
         而 0.0.5 的 ChatResponseUpdateAGUIExtensions 在映射出 RunErrorEvent 后**不终止流**，会继续补
         TEXT_MESSAGE_END + RUN_FINISHED —— 违反 AG-UI 协议（客户端校验器：RUN_ERROR 之后不得再发任何事件）。
         0.0.6 在该处 yield break（见 RecommendationPushAgent 的方法注释）。 -->
    <PackageReference Include="AGUI.Abstractions" />
    <PackageReference Include="AGUI.Server" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AspNetCore" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" />
    <!-- Serilog 结构化日志（Program.cs bootstrap / AddSerilog / WriteTo.Console；版本 CPM 锁定 10.0.0 / 6.1.1） -->
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- .env 加载（模型密钥等敏感配置走 .env/环境变量，同 Api；CPM 锁定 3.2.0） -->
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试缝：使 internal AddAguiBaseServices/InitializeAsync 对 AIShop.AguiHost.Tests 可见（宿主级测试直接驱动装配/启动引导）。
         （property 形式的 <InternalsVisibleTo> 不生成 friend 特性，必须用 item 形式 Include） -->
    <InternalsVisibleTo Include="AIShop.AguiHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
