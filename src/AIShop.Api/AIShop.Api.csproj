<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AIShop.Core\AIShop.Core.csproj" />
    <ProjectReference Include="..\AIShop.Infrastructure\AIShop.Infrastructure.csproj" />
    <ProjectReference Include="..\AIShop.ServiceDefaults\AIShop.ServiceDefaults.csproj" />
    <ProjectReference Include="..\AIShop.AgentTelemetry\AIShop.AgentTelemetry.csproj" />
    <!-- T1: Service 层抽取（Agent 逻辑随迁）。4 个 MAF/DeepSeek 包本工单不移除，T8 处理 -->
    <ProjectReference Include="..\AIShop.Service\AIShop.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepSeek.Agents.AI" Version="1.0.4" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <!-- T2 MAF 升级联动：与 Service/AgentTelemetry 统一 1.18.0（避免 NU1605 包降级与双版本绑定冲突）；4 包移除仍归 T8 -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.18.0" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.18.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cec96733-9c44-43c8-9fb5-f0d4b7058233</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- 测试缝：使 internal static BuildChatHttpPipeline 对测试程序集可见。
         （property 形式的 <InternalsVisibleTo> 不生成 friend 特性，必须用 item 形式 Include） -->
    <InternalsVisibleTo Include="AIShop.Api.Tests" />
  </ItemGroup>

</Project>
