<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AIShop.Core\AIShop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- P2-3: PreferenceQueue 在 DropOldest 满容量挤旧时用 Serilog 静态 Log.Warning 记录观测日志 -->
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <!-- RAG 底座（rag-feature）：向量存储抽象 + SqliteVec provider + 本地 ONNX embedding。
       R5/R9 核对结论：Microsoft.Extensions.AI.ONNX 包在 NuGet 不存在，改用自研 IEmbeddingGenerator
       包装 Microsoft.ML.OnnxRuntime（native+managed 拆分包）+ Microsoft.ML.Tokenizers（tokenizer.json）。 -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.VectorData.SqliteVec" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <!-- bge-small-zh-v1.5 ONNX 模型文件（R4：~95MB，gitignore 不提交 git，首次运行前从 hf-mirror 下载）：
       https://hf-mirror.com/Xenova/bge-small-zh-v1.5/resolve/main/onnx/model.onnx
       https://hf-mirror.com/Xenova/bge-small-zh-v1.5/resolve/main/tokenizer.json
       复制到输出供 EmbeddingGenerator 加载（RagOptions.EmbeddingModelPath 可配置）。 -->
  <ItemGroup>
    <!-- Link 去掉 Rag\ 前缀：模型输出到 Models\bge-small-zh-v1.5\（EmbeddingGenerator 加载路径 = AppContext.BaseDirectory/Models/...） -->
    <Content Include="Rag\Models\bge-small-zh-v1.5\**" CopyToOutputDirectory="PreserveNewest" Link="Models\bge-small-zh-v1.5\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 覆盖传递依赖以修复 NU1903 安全漏洞 -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
